#!/bin/sh
# logmind post-merge hook
# logmind-hook-version: 2.0.0-dev
# Installed by `logmind init` (v0.3.0+). After every merge, regenerate
# derived docs from the FULL post-merge working tree. Belt + suspenders
# with the merge driver in .gitattributes — the driver fires per-file
# during conflict resolution, before sibling non-conflicted files (e.g.
# the merged-in branch's docs/decisions-branches/<branch>.md) are
# checked out. This hook runs once at the end and sweeps any incomplete
# regenerations.
#
# v0.6.7 bug fix: regenerate but do NOT git add. Previously the hook
# auto-staged docs/timeline.md + docs/file-structure.md, but the
# staged-but-uncommitted files then blocked `git checkout main` on
# every PR cycle (post-merge fires from `git pull --rebase` after a
# squash merge — there's no commit being constructed, so staging was
# wrong). Leaving them as unstaged modifications lets the next
# `logmind log` pick them up cleanly without blocking branch switches.
#
# v0.6.10: the line above embeds the binary version that wrote this hook,
# so doctor reports stale-hook drift loudly when the user's local CLI
# binary is stale relative to the workflow's installed version.
#
# v0.6.13 / issue #112: skip regen entirely when the current branch is
# orphaned — i.e., we're on a feature branch that was just squash-merged
# on origin and the remote branch has been deleted. The regen would
# produce content that conflicts with main's just-merged state, and the
# resulting unstaged modifications block `gh pr merge --delete-branch`'s
# follow-up `git checkout main`. Detection without network calls:
# `git rev-parse --abbrev-ref @{u}` returns nonzero / empty when the
# upstream is gone after `git fetch --prune`. Detection failure → fall
# through to today's behavior (regen + leave unstaged); never block on
# detection failure.

if command -v logmind >/dev/null 2>&1 && [ -f .logmind/config.yml ]; then
  # Orphan-branch check: if our upstream tracking ref no longer exists,
  # we were just merged-and-deleted; skip regen.
  upstream=$(git rev-parse --abbrev-ref @{u} 2>/dev/null || true)
  if [ -n "$upstream" ]; then
    if ! git rev-parse --verify --quiet "refs/remotes/$upstream" >/dev/null 2>&1; then
      # Upstream config says <upstream> but no such remote-tracking ref
      # exists (typical after `git fetch --prune` removes the merged
      # branch). Skip regen — main will regen correctly after checkout.
      exit 0
    fi
  fi
  # v0.6.16 (replaces v0.6.15's blanket default-branch skip): on the
  # default branch, only skip when HEAD already matches origin/<default>
  # — i.e., a fast-forward pull-up from server where regen-timeline.yml
  # has already produced the authoritative timeline. For local merges
  # that introduced new commits not yet on origin (the multi-branch
  # self-heal case: `git merge feat-branch` on main), regen MUST fire
  # so the working tree reflects the merged-in decision files. v0.6.15's
  # blanket skip dropped Decision-B-style entries from local main; the
  # multi-branch self-heal regression test in tests/test_merge_driver.py
  # catches this. Surfaces the bug PRE-merge instead of in a downstream
  # check-derived-docs failure weeks later.
  current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  default=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
  # --short on a remote symbolic-ref leaves the `origin/` prefix
  # in place; strip it so the bare-name comparison below works.
  default=${default#origin/}
  [ -z "$default" ] && default=main
  if [ -n "$current" ] && [ "$current" != "$default" ]; then
    # v2.0.0 derived-docs-on-main: never regenerate on a non-default branch —
    # the branch must keep the derived docs byte-identical to its main
    # merge-base (the zero-conflict invariant). main regenerates post-merge.
    exit 0
  fi
  if [ -n "$current" ] && [ "$current" = "$default" ]; then
    head_sha=$(git rev-parse HEAD 2>/dev/null || true)
    origin_sha=$(git rev-parse "origin/$default" 2>/dev/null || true)
    if [ -n "$origin_sha" ] && [ "$head_sha" = "$origin_sha" ]; then
      exit 0
    fi
  fi
  if [ -d docs ]; then
    logmind timeline --write docs/timeline.md >/dev/null 2>&1 || true
    logmind file-structure --write docs/file-structure.md >/dev/null 2>&1 || true
  fi
fi
