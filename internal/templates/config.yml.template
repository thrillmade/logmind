# logmind configuration
# This file controls how logmind behaves in this project

# Git integration
git:
  # Push automatically after committing. With the default `--stage all`,
  # anything else in the working tree rides along in the same commit —
  # push follows accordingly. Use `--stage scoped` (or set this false) if
  # you want to review/split unrelated changes before they leave your
  # machine.
  auto_push: true

  # Commit message template
  # Available variables: {decision}
  commit_message_template: "logmind: {decision}"

  # Block substantive commits that bypass `logmind log` (commit-msg + Claude
  # Code PreToolUse hooks). Set false to fall back to warn-only for this repo.
  enforce_commits: true
  # Lines-changed threshold. SPEC §3.4 makes this the ONE source for every
  # enforcement point — the commit-msg hook, the harness guard, and the CI
  # gate. `logmind check-decisions --threshold` overrides it locally, but is
  # refused alongside `--base/--head`: the gate reads this file and nothing
  # else, so a pull request cannot raise its own bar.
  commit_line_threshold: 20

# Decision management
decisions:
  # Route each branch's decisions to docs/decisions-branches/<branch>.md —
  # the default branch included, it is a branch like any other. Every file is
  # append-only and uncapped; what is bounded is the VIEW (docs/timeline.md
  # carries the 50 most recent entries, docs/timeline-archive.md the rest).
  # Set to false to log every branch into the same file (legacy behavior).
  branch_aware: true

# File structure generation
file_structure:
  # Directories and files to ignore in tree output.
  # logmind also reads the project's .gitignore and unions these patterns.
  ignore_patterns:
    # Python
    - __pycache__
    - .git
    - venv
    - .venv
    - env
    - .env
    - "*.pyc"
    - .pytest_cache
    - .mypy_cache
    - dist
    - build
    - "*.egg-info"
    # Node / Next.js / Vercel / Turbo
    - node_modules
    - .next
    - .vercel
    - .turbo
    - out
    - .cache
    - .nyc_output
    - coverage
    - "*.tsbuildinfo"
    # General
    - .DS_Store
    - "*.log"
