# logmind-template-version: v12
name: logmind / check-derived-docs

# v2.0.0 derived-docs-on-main. The two derived docs are regenerated ONLY here on
# main. On a PR this gate is NON-mutating and BLOCKING: it fails if the branch
# edited either derived doc (which would cause cross-PR merge conflicts). A
# branch's real decisions live in docs/decisions-branches/<branch>.md; timeline
# and file-structure regenerate on main after merge.
#
# v10: the zero-conflict invariant is now UNCONDITIONAL for every repo running
# this workflow — v9's per-repo `derived_docs.mode: integration-point`
# adoption gate (and its "hasn't opted in → pass" escape) is removed. The
# blocking check always applies; there is no way to opt out from within a PR.
#
# v11: regen-on-main's push step no longer treats "no credential" and "push
# refused" alike (SPEC-2 §3.3, logmind#262). No credential still degrades —
# warn + exit 0. A push that was attempted and refused now fails the job
# (::error + exit 1): it is the job not doing its job, and reporting it as
# success is how a regenerator stays broken for weeks while every run is
# green.
#
# v12: the push credential is a CHAIN, not one hardcoded secret. v11 shipped
# a raw `LOGMIND_AUTO_REGEN_PAT` as the only rung — the credential path this
# repo itself had already moved off — so a repo with a GitHub App configured
# could not use it and a repo with neither warned and did nothing. The chain
# now degrades: a GitHub App installation token if App credentials are
# configured, else a PAT if one is, else the workflow's own GITHUB_TOKEN,
# which always exists. The App rung is an OPTIMIZATION, never a dependency:
# logmind must work in a repo with no App, no PAT, and no organization
# behind it. What v11 established survives unchanged — no credential at all
# still degrades (warning + exit 0), a push that was attempted and refused
# still fails the job (::error + exit 1) — the chain only changes which
# credential is tried, never how the outcomes are reported.
#
# v12 also stops assuming the default branch is called `main`. It was
# hardcoded in four operative places — the push refspec (`HEAD:main`), the
# `on: push:` filter, the PR gate's remediation command, and the ruleset
# error message — so a repo on `master` or `trunk` either regenerated onto
# a branch it does not have or never regenerated at all. Everything
# evaluated at RUNTIME now reads `github.event.repository.default_branch`;
# the one thing that cannot (an `on:` filter takes no expression) is
# substituted at scaffold time by `logmind init`, and the PR gate warns
# when the two have drifted apart. Same principle as the credential chain:
# logmind must work standalone, which means assuming nothing about how a
# repository is set up.

on:
  pull_request:
    types: [opened, synchronize, reopened]
  push:
    # NOT hardcoded to `main`. A workflow's `on:` filter cannot take an
    # expression — GitHub evaluates no context under `on:` — so `logmind
    # init` substitutes this repository's actual default branch here at
    # scaffold time, the same way it substitutes __LOGMIND_VERSION__
    # elsewhere. A repo on `master`, `trunk`, or anything else gets its own
    # name written in.
    #
    # Broadening this to `branches: ['**']` and gating the job instead is
    # NOT an option here: this file also carries `check-derived-docs`, a
    # PR-blocking required check, and a job skipped by its own `if:`
    # reports SUCCESS to required status checks. Every push to a PR branch
    # would then add a second `check-derived-docs` run on the same head SHA
    # that passed without evaluating anything.
    #
    # If the default branch is renamed later, this line goes stale and the
    # regen simply stops firing — so the PR gate below compares it against
    # the live default branch and warns. `logmind init --refresh` rewrites it.
    branches: [__LOGMIND_DEFAULT_BRANCH__]

permissions:
  contents: write        # regen-on-main commits + pushes the regen to the default branch
  pull-requests: read    # the PR gate reads the PR file list via `gh pr diff`
  # NOTE: specifying ANY permission zeroes all others (GitHub default), so
  # pull-requests MUST be listed explicitly — without it `gh pr diff` 403s and
  # the gate fails-closed on EVERY PR, not just violators.

jobs:
  check-derived-docs:
    name: check-derived-docs
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      # NO checkout, deliberately. This job only needs the PR's file list —
      # never the PR's own content — via `gh pr diff`. A checkout on a
      # pull_request event lands refs/pull/N/merge (the PR's own content);
      # staying checkout-free means there is nothing here for a PR to
      # influence about its own gate.
      - name: Assert the branch did not edit the derived docs
        env:
          GH_TOKEN: ${{ github.token }}
          PR: ${{ github.event.pull_request.number }}
          # The live default branch, and the one baked into `on: push:` when
          # this workflow was scaffolded. They are compared below: a rename
          # of the default branch leaves the regen trigger pointing at a
          # branch that no longer exists, and nothing else would ever say so.
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          SCAFFOLDED_BRANCH: __LOGMIND_DEFAULT_BRANCH__
        run: |
          set -euo pipefail
          if [ "$SCAFFOLDED_BRANCH" != "$DEFAULT_BRANCH" ]; then
            echo "::warning title=Derived-doc regen is wired to the wrong branch::This workflow's 'on: push:' filter was scaffolded for '$SCAFFOLDED_BRANCH', but this repository's default branch is now '$DEFAULT_BRANCH'. The regen job therefore never fires, and the derived docs on '$DEFAULT_BRANCH' will drift stale — silently, because nothing else reports it. Fix: run 'logmind init --refresh' to rewrite the trigger."
          fi
          changed=$(gh pr diff "$PR" --name-only --repo "$GITHUB_REPOSITORY")
          if printf '%s\n' "$changed" | grep -qxE 'docs/(timeline|file-structure)\.md'; then
            echo "::error title=Derived docs were edited on this branch::This PR modifies docs/timeline.md and/or docs/file-structure.md. These are DERIVED, default-branch-only artifacts; editing them on a branch causes the cross-PR merge conflicts v2.0.0 eliminates. Fix: revert them to the default branch's version — run 'logmind warp', or 'git checkout origin/$DEFAULT_BRANCH -- docs/timeline.md docs/file-structure.md' — then commit. Their real content regenerates on '$DEFAULT_BRANCH' after merge."
            exit 1
          fi
          echo "Branch did not edit the derived docs — the merge cannot conflict on them."

  regen-on-main:
    name: regen-on-main
    # The trigger above already narrows this to one branch, but the trigger
    # is a scaffold-time literal and this is the live value: if the two ever
    # disagree, the regen must NOT run and push to a non-default branch.
    # (The job id/name keep saying "main" because the decision log and the
    # ruleset history refer to them by that name; what the job DOES is
    # resolved, not assumed.)
    if: github.event_name == 'push' && github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    # CREDENTIAL CHAIN, rung 1 — OPTIONAL. The two lines below are the only
    # thing a repository customises to enable the GitHub App rung; every
    # other line of the credential mechanism is identical in every repo that
    # installs this workflow, which is what keeps this file and logmind's own
    # copy of it from drifting apart. Leave them pointing at secrets you have
    # not configured and nothing breaks: the chain falls through to rung 2 (a
    # PAT) and then rung 3 (the workflow's own GITHUB_TOKEN). The App is an
    # OPTIMIZATION — it is the only identity that can be granted a ruleset
    # bypass, so it is what makes this work on a protected default branch —
    # never a dependency.
    env:
      APP_ID: ${{ secrets.LOGMIND_APP_ID }}
      APP_PRIVATE_KEY: ${{ secrets.LOGMIND_APP_PRIVATE_KEY }}
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: thrillmade/setup-logmind@v1.0.1
        with:
          token: ${{ github.token }}
      - name: Regenerate derived docs
        run: |
          set -euo pipefail
          logmind timeline --write docs/timeline.md
          logmind file-structure --write docs/file-structure.md
      # Rung 1: mint a short-lived (1 hour) App installation token, but only
      # when App credentials are actually configured. The `if:` reads the job
      # `env` above rather than `secrets` directly because the `secrets`
      # context is NOT available to a step-level `if:`. `continue-on-error`
      # covers the other half: a misconfigured or expired App must degrade to
      # rung 2, not fail the job. `owner`/`repositories` are deliberately
      # omitted — the action defaults both to the current repository, which
      # is what a shipped template must do.
      - name: Mint GitHub App installation token (optional)
        id: app_token
        if: env.APP_ID != '' && env.APP_PRIVATE_KEY != ''
        continue-on-error: true
        uses: actions/create-github-app-token@v3
        with:
          app-id: ${{ env.APP_ID }}
          private-key: ${{ env.APP_PRIVATE_KEY }}

      - name: Commit + push if changed
        env:
          APP_TOKEN: ${{ steps.app_token.outputs.token }}
          PAT: ${{ secrets.LOGMIND_AUTO_REGEN_PAT }}
          DEFAULT_TOKEN: ${{ github.token }}
          # Resolved from the event, never assumed to be `main`. Passed
          # through env rather than interpolated into the script: a branch
          # name is attacker-influenceable text, and `${{ }}` inside a
          # `run:` block is a script-injection site.
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: |
          set -euo pipefail
          if [ -z "$(git status --porcelain -- docs/timeline.md docs/file-structure.md)" ]; then
            echo "Derived docs already current on '$DEFAULT_BRANCH'."
            exit 0
          fi
          # The chain, in order. Rung 3 always exists, so "configured
          # nothing" now ATTEMPTS the push instead of warning and doing
          # nothing — a regenerator that reports success while never pushing
          # is how one stays broken for weeks with every run green.
          if [ -n "${APP_TOKEN:-}" ]; then
            TOKEN="$APP_TOKEN"
            RUNG="a GitHub App installation token"
          elif [ -n "${PAT:-}" ]; then
            TOKEN="$PAT"
            RUNG="LOGMIND_AUTO_REGEN_PAT"
          elif [ -n "${DEFAULT_TOKEN:-}" ]; then
            TOKEN="$DEFAULT_TOKEN"
            RUNG="the workflow's own GITHUB_TOKEN"
          else
            echo "::warning title=Derived docs stale on the default branch::No credential of any kind is available to push the regen — no GitHub App token, no LOGMIND_AUTO_REGEN_PAT, and not even the workflow's own GITHUB_TOKEN. This will keep failing on every run until one is configured — it will NOT self-heal on the next merge. (No conflict risk — this is a freshness-only gap: branches never modify the derived docs, so nothing can conflict on them.)"
            exit 0
          fi
          echo "Pushing the derived-doc regen with $RUNG."
          # The commit author is github-actions[bot] on every rung. What a
          # protected branch evaluates is the identity of the PUSHING token,
          # not the commit author, so keying the author to the rung would buy
          # nothing and cost a line the two copies of this file could drift on.
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add docs/timeline.md docs/file-structure.md
          git commit -m "[skip-logmind] chore: regen derived docs"
          # SPEC-2 §3.3: "Three outcomes, and they MUST NOT look alike."
          # Nothing-to-push exits 0 quietly. No credential at all (above)
          # degrades — a warning and a successful exit, because a merge that
          # was otherwise fine should not fail over it. A push that was
          # attempted and refused is different: "a refused write is the job
          # not doing its job", so unlike the no-credential case this one
          # MUST fail the job, loudly. If your default branch is protected by
          # a "changes must be made through a pull request" rule, a plain
          # credentialed push is rejected (GH013) no matter how much scope
          # the token has — the pushing identity must be on the ruleset
          # BYPASS list, and only a GitHub App (rung 1) can be added to one.
          # That's a policy refusal, NOT transient: every future push hits
          # the same refusal until a human adds the identity to the bypass
          # list.
          if ! git push "https://x-access-token:${TOKEN}@github.com/${GITHUB_REPOSITORY}.git" "HEAD:${DEFAULT_BRANCH}"; then
            echo "::error title=Derived-doc regen push refused::The push was rejected while authenticating with $RUNG — most likely GH013: that identity is missing from the '$DEFAULT_BRANCH' ruleset's bypass list for 'changes must be made through a pull request'. This is a POLICY refusal, not a token-scope problem, so it will NOT self-heal on the next merge — every future push hits the same refusal until the identity is added to the bypass list. Only a GitHub App can be a bypass actor, so a repo pushing with a PAT or GITHUB_TOKEN must configure LOGMIND_APP_ID / LOGMIND_APP_PRIVATE_KEY to get past a rule like this. No conflict risk — branches never modify the derived docs, so nothing can conflict on them — but '$DEFAULT_BRANCH' derived docs are now stale and this run failed to fix that."
            exit 1
          fi
