# logmind-template-version: v5
name: logmind / check-derived-docs

# Derived-file architecture (v0.2+): docs/timeline.md + docs/file-structure.md
# are derived artifacts, deterministically computed from sources (per-branch
# logs + decisions.md + archive for timeline; tree walk for file-structure).
#
# v5 (logmind v1.2.1+) — GITHUB_TOKEN single-job dual-mode.
#
# The v4 PAT-based design (LOGMIND_AUTO_REGEN_PAT) failed for Dependabot
# PRs because GitHub isolates repo secrets from PRs authored by bots —
# the secret resolves to empty in that context, forcing fail-fast on
# every Dependabot PR. Worse, Dependabot PRs are the COMMON case for
# stale derived-doc drift (each bump shifts file-structure.md
# byte-by-byte without touching decisions).
#
# v5 mirrors the v4→v5 pattern that already shipped in
# check-doc-links.yml: a single job that (a) regenerates derived docs
# with the embedded logmind binary, (b) commits + pushes via
# GITHUB_TOKEN to the PR head ref, (c) re-verifies in the same
# execution. The auto-commit + re-verify happen in ONE workflow run —
# GITHUB_TOKEN's "doesn't trigger downstream workflows" limitation
# doesn't matter because we don't need a downstream trigger; verify is
# the final step.
#
# Works for:
#   - Author PRs (normal flow)
#   - Dependabot PRs (GITHUB_TOKEN works; PAT doesn't)
#   - Forked PRs (read-only fallback — can't push to fork's head ref;
#     post-merge regen on main catches them)
#
# No PAT configuration required. No per-repo secret setup. Default
# zero-config self-heal.
#
# Replaces the v0.1.x `logmind-aggregate.yml` workflow.

on:
  pull_request:
    types: [opened, synchronize, reopened]
  push:
    branches: [main, master]

permissions:
  contents: write       # auto-commit regen back to PR head ref
  pull-requests: read

jobs:
  check-derived-docs:
    # Skip for dependabot PRs at the GH-trigger boundary? NO — v5
    # explicitly handles Dependabot PRs since GITHUB_TOKEN works for
    # them (unlike the v4 PAT path). The previous `if:` filter caused
    # the check to be marked "Expected — Waiting" forever on Dependabot
    # PRs, blocking their merge gate. v5 lets them in.
    name: check-derived-docs
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          # For PRs, check out the PR's head ref so the regen + push
          # apply to the right branch. For push events to main, check
          # out the main ref directly.
          ref: ${{ github.event.pull_request.head.ref || github.ref }}
          repository: ${{ github.event.pull_request.head.repo.full_name || github.repository }}
          fetch-depth: 0
          # GITHUB_TOKEN works in all contexts (PRs, Dependabot, push
          # events). Replaces the v4 PAT-or-token compound expression.
          token: ${{ secrets.GITHUB_TOKEN }}

      # logmind v1.1.0 (2026-06-05) switched from `pip install logmind==X.Y.Z`
      # to the dedicated `thrillmade/setup-logmind` action. The action handles
      # platform detection, version pinning, and step caching uniformly across
      # consumer repos. Dependabot keeps the action ref current via the
      # `github-actions` ecosystem block in `.github/dependabot.yml` (also
      # installed by `logmind init`).
      - uses: thrillmade/setup-logmind@v1.0.1

      - name: Regenerate derived docs
        run: |
          set -euo pipefail
          if [ ! -f docs/timeline.md ]; then
            echo "::error::docs/timeline.md is missing. Run \`logmind timeline --write docs/timeline.md\` and commit the file."
            exit 1
          fi
          logmind timeline --write docs/timeline.md
          logmind file-structure --write docs/file-structure.md

      - name: Auto-commit regen + verify
        env:
          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}
          BASE_REPO: ${{ github.repository }}
          HEAD_REF: ${{ github.event.pull_request.head.ref }}
          EVENT_NAME: ${{ github.event_name }}
        run: |
          set -euo pipefail
          # No diff after regen → already current. Verify passes.
          if git diff --quiet docs/timeline.md docs/file-structure.md 2>/dev/null; then
            echo "docs/timeline.md + docs/file-structure.md are up to date."
            exit 0
          fi

          echo "Derived docs were stale on this PR; regenerating in place."

          # Forked PR — can't push back to the fork's head ref.
          # Fall back to fail-fast (post-merge regen on main catches this).
          if [ "$EVENT_NAME" = "pull_request" ] && [ "$HEAD_REPO" != "$BASE_REPO" ]; then
            echo "::error title=Stale derived docs::PR is from a fork ($HEAD_REPO). Auto-fix cannot push back. Run \`logmind timeline --write docs/timeline.md && logmind file-structure --write docs/file-structure.md\` locally and commit the regenerated files."
            git --no-pager diff docs/timeline.md docs/file-structure.md | head -80
            exit 1
          fi

          # Push events to main — regen + commit + push directly.
          # PRs (non-fork) — regen + commit + push to the PR head ref.
          # In both cases, GITHUB_TOKEN is the auth.
          #
          # Use the canonical github-actions[bot] identity (the fake
          # `logmind-auto-regen@users.noreply.github.com` email from v4
          # isn't owned by any GitHub user — Vercel + many CI tools
          # reject deployments authored by it).
          echo "::notice title=Auto-fixing stale derived docs::Regenerating and committing via GITHUB_TOKEN."
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add docs/timeline.md docs/file-structure.md
          git commit -m "chore: regen derived docs [auto]

          Auto-fix by logmind's check-derived-docs workflow (v5).
          The PR's docs/timeline.md or docs/file-structure.md was stale
          after a code change. Regenerated from the per-branch decision
          files (timeline) and current tree (file-structure)."

          # Push to the appropriate ref. PR → head ref; push → current branch.
          if [ "$EVENT_NAME" = "pull_request" ]; then
            git push origin "HEAD:${HEAD_REF}"
          else
            git push origin HEAD
          fi

          # Final verify in the SAME job — re-run the regen check.
          # Since we just regen'd, this should pass; if not, something is
          # non-deterministic about the regen and that's a real bug.
          logmind timeline --check --write docs/timeline.md
          logmind file-structure --check --write docs/file-structure.md
          echo "::notice::Derived docs regenerated, committed, and verified clean."
